# ==========================================================
# LINGUALEARN PLATFORM CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env before starting the application
# ==========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lingualearn_db
DB_USER=postgres
DB_PASSWORD=postgres

# Security & Authentication
JWT_SECRET=lingualearn_dev_jwt_secret_key_change_in_production_2026!
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# AI Configuration (Optional: Leave blank to use Deterministic Intelligent Fallback)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
